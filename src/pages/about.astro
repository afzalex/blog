---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { Image } from "astro:assets";
import profileImage from "../assets/mohammad-afzal-profile.png";
import { SITE } from "../lib/blog-data.js";

const description =
  "About Mohammad Afzal, a Senior Staff Engineer working across backend systems, cloud platforms, software modernization, and engineering leadership.";

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mohammad Afzal",
  jobTitle: "Senior Staff Engineer",
  description,
  sameAs: [
    "https://github.com/afzalex",
    "https://www.linkedin.com/in/afzalex",
    "https://stackoverflow.com/users/3626698/afzalex",
  ],
  knowsAbout: [
    "Java",
    "Spring Boot",
    "Microservices",
    "Amazon Web Services",
    "Kubernetes",
    "Cloud architecture",
    "Continuous integration and delivery",
    "Distributed systems",
  ],
};

const experience = [
  {
    period: "2025 - present",
    role: "Senior Staff Engineer",
    organization: "First Abu Dhabi Bank, via Nagarro",
    summary:
      "Digital banking systems, modernization, production reliability, and engineering leadership.",
  },
  {
    period: "2024 - 2025",
    role: "Lead Cloud Engineer",
    organization: "Liberty Mutual, via Technumen",
    summary:
      "Cloud architecture, Spring Boot APIs, AWS automation, and reusable delivery platforms for insurance systems.",
  },
  {
    period: "2023 - 2024",
    role: "Full Stack Developer",
    organization: "Northern Trust, via eTeams",
    summary:
      "Microservices, enterprise authentication, automated delivery, and performance testing.",
  },
  {
    period: "2020 - 2023",
    role: "Product Development Engineer",
    organization: "Calibo",
    summary:
      "Cloud-native product development across microservices, Kubernetes, data platforms, and DevOps.",
  },
  {
    period: "2019 - 2020",
    role: "Senior Associate",
    organization: "Nagarro",
    summary:
      "Scalable enterprise applications and microservices for digital engineering workflows.",
  },
  {
    period: "2015 - 2019",
    role: "Senior Software Engineer",
    organization: "Enbraun",
    summary:
      "The architecture and first public release of a multi-user resource-management platform.",
  },
];
---

<BaseLayout
  title={`About Mohammad Afzal - ${SITE.name}`}
  description={description}
  canonical="/about"
  jsonLd={personJsonLd}
>
  <div class="mx-auto max-w-4xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "About" }]} />

    <header class="mt-8 border-b border-border pb-12">
      <div class="flex flex-col gap-7 sm:flex-row sm:items-center">
        <Image
          src={profileImage}
          alt="Mohammad Afzal"
          width="112"
          height="112"
          widths={[112, 224]}
          sizes="112px"
          format="webp"
          class="h-28 w-28 rounded-full border border-border object-cover"
        />
        <div>
          <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">About</div>
          <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05] tracking-tight">
            I build reliable software systems—and write down what I learn.
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">
            I'm Mohammad Afzal, a Senior Staff Engineer working across backend systems,
            cloud platforms, software modernization, and engineering leadership.
          </p>
        </div>
      </div>

      <nav class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Professional profiles">
        <a
          href="https://github.com/afzalex"
          rel="me"
          class="underline decoration-border underline-offset-4 hover:text-primary"
        >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/afzalex"
          rel="me"
          class="underline decoration-border underline-offset-4 hover:text-primary"
        >
          LinkedIn
        </a>
        <a
          href="https://stackoverflow.com/users/3626698/afzalex"
          rel="me"
          class="underline decoration-border underline-offset-4 hover:text-primary"
        >
          Stack Overflow
        </a>
      </nav>
    </header>

    <article class="prose-article mt-12">
      <h2 id="what-i-do">What I do</h2>
      <p>
        For more than ten years, I have built and modernized software across digital
        banking, insurance, SaaS, ERP, and product platforms. Most of my work sits
        between application architecture and platform engineering: designing backend
        services, making cloud infrastructure repeatable, improving delivery pipelines,
        and keeping production systems dependable.
      </p>
      <p>
        My core stack includes Java, Spring Boot, microservices, AWS, Kubernetes, and
        CI/CD. I have also worked across frontend applications, data and machine-learning
        platforms, observability, enterprise integrations, and applied AI. The common
        thread is practical engineering: understanding the system end to end and taking
        responsibility for how it behaves in production.
      </p>

      <h2 id="today">What I am doing now</h2>
      <p>
        I currently work as a Senior Staff Engineer with First Abu Dhabi Bank through
        Nagarro. I lead a team of five engineers working on mission-critical digital
        banking applications, with responsibility spanning new development,
        modernization, releases, hotfixes, incident resolution, and production
        reliability.
      </p>
      <p>
        Before that, I led cloud engineering work for Liberty Mutual's insurance
        platforms, including Spring Boot APIs, AWS infrastructure, Kubernetes delivery,
        automation, and integrations around AI-driven systems.
      </p>
    </article>

    <section class="mt-14" aria-labelledby="experience-heading">
      <div class="border-b border-border pb-4">
        <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Experience</div>
        <h2 id="experience-heading" class="mt-2 font-serif text-3xl font-semibold tracking-tight">
          The path here
        </h2>
      </div>

      <ol class="divide-y divide-border">
        {
          experience.map((item) => (
            <li class="grid gap-2 py-6 sm:grid-cols-[8rem_1fr] sm:gap-6">
              <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                {item.period}
              </div>
              <div>
                <h3 class="font-serif text-xl font-semibold">{item.role}</h3>
                <div class="mt-1 text-sm font-medium text-primary">{item.organization}</div>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.summary}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-14 grid gap-10 border-t border-border pt-10 md:grid-cols-2">
      <div>
        <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Education</div>
        <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight">Learning in layers</h2>
        <ul class="mt-5 space-y-5">
          <li>
            <div class="font-medium">Master of Science in Data Science</div>
            <div class="mt-1 text-sm text-muted-foreground">Liverpool John Moores University</div>
          </li>
          <li>
            <div class="font-medium">Executive PG Programme in Data Science</div>
            <div class="mt-1 text-sm text-muted-foreground">IIIT Bangalore</div>
          </li>
          <li>
            <div class="font-medium">Bachelor of Technology in Computer Science</div>
            <div class="mt-1 text-sm text-muted-foreground">Uttarakhand Technical University</div>
          </li>
        </ul>
      </div>

      <div>
        <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">This site</div>
        <h2 class="mt-2 font-serif text-2xl font-semibold tracking-tight">Why I write</h2>
        <div class="mt-5 space-y-4 text-sm leading-relaxed text-muted-foreground">
          <p>
            This blog is where I document the systems I build, operate, and learn from:
            cloud architecture, automation, networking, self-hosting, developer tools,
            and the small technical decisions that make infrastructure more reliable.
          </p>
          <p>
            I prefer useful details over polished abstractions. When something works,
            breaks, or teaches me a better mental model, I try to leave behind a clear
            account that another engineer can use.
          </p>
        </div>
        <a
          href="/blog"
          class="mt-6 inline-flex rounded-md bg-foreground px-5 py-2.5 text-sm font-medium text-background hover:opacity-90"
        >
          Read my writing
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
